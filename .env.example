# ---------------------------------------------------------------------------
# Copy to `.env` and edit. All variables are optional; defaults are shown.
# ---------------------------------------------------------------------------

# --- Storage -----------------------------------------------------------------
# SQLAlchemy URL for the structured store (tree, versions, selections).
CT200_DATABASE_URL=sqlite:///./ct200.db

# LLM output store: "json" (default, append-only JSONL) or "mongo".
CT200_GENERATION_STORE=json
CT200_GENERATION_STORE_PATH=./data/generations.jsonl
CT200_MONGO_URI=mongodb://localhost:27017
CT200_MONGO_DB=ct200

# --- LLM ---------------------------------------------------------------------
# provider: mock | openai | groq | openrouter | gemini
# "mock" is a deterministic offline provider so the whole pipeline runs with
# no API key. Swap it for a real provider to hit a live model.
CT200_LLM_PROVIDER=mock
CT200_LLM_MODEL=llama-3.1-8b-instant
CT200_LLM_API_KEY=
# Optional override for OpenAI-compatible endpoints (groq/openrouter/openai).
CT200_LLM_BASE_URL=
CT200_LLM_TIMEOUT=30
CT200_LLM_MAX_RETRIES=2
# Bump this whenever you change the prompt; it participates in the
# idempotency fingerprint so old generations are not silently reused.
CT200_PROMPT_VERSION=v1

# --- Parser ------------------------------------------------------------------
CT200_OCR_ENABLED=true
CT200_OCR_MIN_CHARS_PER_PAGE=40
CT200_OCR_DPI=200
